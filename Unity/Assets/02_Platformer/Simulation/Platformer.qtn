singleton component PlatformerGameplay
{
	[Tooltip("Minimum number of coins required to win the game")]
	int MinCoinsToWin;
	[Tooltip("Time to show the game result before new round starts")]
	FP GameOverTime;
	[Tooltip("Initial spawn position for players")]
	FPVector3 SpawnPosition;
	[Tooltip("Radius around spawn position where players can be placed")]
	FP SpawnRadius;

	[ExcludeFromPrototype]
	PlayerRef Winner;
	[ExcludeFromPrototype]
	FrameTimer GameOverTimer;
}

component PlatformerPlayer
{
	[ExcludeFromPrototype]
	int CollectedCoins;
}

component Flag
{
}

component Coin
{
	[Tooltip("Time until coin respawns after being collected")]
	FP RefreshTime;

	[ExcludeFromPrototype]
	FrameTimer RefreshTimer;
}

component FallingPlatform
{
	[Tooltip("Time delay before platform starts falling")]
	FP FallDelay;
	[Tooltip("Time until platform resets to original position")]
	FP ResetTime;

	[ExcludeFromPrototype]
	FPVector3 OriginalPosition;
	[ExcludeFromPrototype]
	FrameTimer FallTimer;
	[ExcludeFromPrototype]
	FrameTimer ResetTimer;
}

signal CoinCollected(EntityRef entity);

event CoinCollected
{
	EntityRef Entity;
	EntityRef Collector;
}

event PlatformFell
{
	EntityRef Entity;
}

enum GrowableStage
{
	Seed = 0,
	Emerging = 1,
	Seedling = 2,
	Established = 3
}

enum GrowableID
{
	GreenBean = 0
}

component QGrowable
{
	GrowableID ID;
	int Age;
	GrowableStage Stage;
}